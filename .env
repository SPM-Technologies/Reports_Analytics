# Local POC settings for docker compose (plain text, like db.properties). Change for any shared/real use.
POSTGRES_PASSWORD=Pass@1234
CLICKHOUSE_ADMIN_PASSWORD=ChAdmin@1234
CLICKHOUSE_APP_PASSWORD=Report@1234
REPORTING_RO_PASSWORD=RoPass@1234
DEBEZIUM_PASSWORD=Dbz@1234
# rows generated by the optional seed profile
SEED_ROWS=100000
# application's own PostgreSQL role (created by the app at startup; row-level security applies to it)
APP_DB_PASSWORD=PrApp@1234
# first sign-in user, created only when there are no users yet (change the password after signing in)
BOOTSTRAP_ADMIN_PASSWORD=Admin@1234
# hospital that load-data.bat / the seed profile adds patients to (1 = H001)
SEED_HOSPITAL=1
# demo hospitals H002/H003 and the demo users of the guide, created at start if missing (POC only)
DEMO_DATA=true
DEMO_PASSWORD=Demo@1234
