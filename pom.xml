<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hospital</groupId>
    <artifactId>patient-registration-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Patient Registration (parent)</name>

    <!--
        Modular monolith: every module is a jar, pr-app assembles them into ONE war
        (pr-app/target/patient-registration.war). See Docs/Solution-Architecture.html, section 6.
        All libraries are open source (Apache 2.0 / BSD / EPL / MIT / LGPL-MPL). No commercial licences.
    -->
    <modules>
        <module>pr-shared</module>
        <module>pr-identity</module>
        <module>pr-registration</module>
        <module>pr-reporting</module>
        <module>pr-ui</module>
        <module>pr-app</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.version>6.2.10</spring.version>
        <!-- the Spring Security release built against exactly this Spring version -->
        <spring-security.version>6.4.9</spring-security.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOMs pin every Spring and Spring Security artifact, including transitive ones, to one version -->
            <dependency><groupId>org.springframework</groupId><artifactId>spring-framework-bom</artifactId><version>${spring.version}</version><type>pom</type><scope>import</scope></dependency>
            <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-bom</artifactId><version>${spring-security.version}</version><type>pom</type><scope>import</scope></dependency>

            <!-- project modules -->
            <dependency><groupId>com.hospital</groupId><artifactId>pr-shared</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.hospital</groupId><artifactId>pr-identity</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.hospital</groupId><artifactId>pr-registration</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.hospital</groupId><artifactId>pr-reporting</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.hospital</groupId><artifactId>pr-ui</artifactId><version>${project.version}</version></dependency>

            <!-- Spring -->
            <dependency><groupId>org.springframework</groupId><artifactId>spring-webmvc</artifactId><version>${spring.version}</version></dependency>
            <dependency><groupId>org.springframework</groupId><artifactId>spring-jdbc</artifactId><version>${spring.version}</version></dependency>
            <dependency><groupId>org.springframework</groupId><artifactId>spring-test</artifactId><version>${spring.version}</version></dependency>

            <!-- Database -->
            <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>42.7.4</version></dependency>
            <dependency><groupId>com.zaxxer</groupId><artifactId>HikariCP</artifactId><version>5.1.0</version></dependency>

            <!-- Reporting: ClickHouse JDBC driver (Apache 2.0) and Jackson for the JSON API -->
            <dependency><groupId>com.clickhouse</groupId><artifactId>clickhouse-jdbc</artifactId><version>0.7.2</version></dependency>
            <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.18.2</version></dependency>
            <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId><version>2.18.2</version></dependency>

            <!-- Exports: Excel (Apache POI) and PDF (OpenPDF) -->
            <dependency><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId><version>5.3.0</version></dependency>
            <dependency><groupId>com.github.librepdf</groupId><artifactId>openpdf</artifactId><version>1.3.43</version></dependency>

            <!-- Logging. APIs pinned so transitive 1.7.x / 2.23.x versions do not win;
                 a mismatched slf4j-api silently turns all logging into a no-op. -->
            <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.16</version></dependency>
            <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>2.0.16</version></dependency>
            <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><version>2.24.1</version></dependency>
            <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-to-slf4j</artifactId><version>2.24.1</version></dependency>

            <!-- JSP / JSTL (Tomcat does not ship JSTL) and the Servlet API provided by Tomcat 11 -->
            <dependency><groupId>jakarta.servlet.jsp.jstl</groupId><artifactId>jakarta.servlet.jsp.jstl-api</artifactId><version>3.0.2</version></dependency>
            <dependency><groupId>org.glassfish.web</groupId><artifactId>jakarta.servlet.jsp.jstl</artifactId><version>3.0.1</version></dependency>
            <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><version>6.1.0</version><scope>provided</scope></dependency>

            <!-- Tests -->
            <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
            <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>3.26.3</version><scope>test</scope></dependency>
            <dependency><groupId>org.hamcrest</groupId><artifactId>hamcrest</artifactId><version>2.2</version><scope>test</scope></dependency>
            <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>1.3.0</version><scope>test</scope></dependency>
            <!-- spring-security-test (version from the Spring Security BOM) -->
            <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><version>${spring-security.version}</version><scope>test</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
