{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "debezium",
  "database.password": "${env:DBZ_PASSWORD}",
  "database.dbname": "postgres",
  "topic.prefix": "pr",
  "table.include.list": "patientreg.report_outbox",
  "publication.name": "pr_outbox_pub",
  "publication.autocreate.mode": "disabled",
  "slot.name": "pr_outbox_slot",
  "snapshot.mode": "no_data",
  "skipped.operations": "u,d,t",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "UPDATE patientreg.cdc_heartbeat SET ts = now() WHERE id = 1",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.key": "aggregateid",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.route.topic.replacement": "pr.patient.report",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false"
}
