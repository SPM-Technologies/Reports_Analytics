<div class="subnav">
    <a class="btn ${adminTab == 'users' ? 'active' : ''}" href="${ctx}/admin/users">Users</a>
    <a class="btn ${adminTab == 'roles' ? 'active' : ''}" href="${ctx}/admin/roles">Roles</a>
    <c:if test="${tenant.superAdmin}">
        <a class="btn ${adminTab == 'hospitals' ? 'active' : ''}" href="${ctx}/admin/hospitals">Hospitals</a>
    </c:if>
    <a class="btn ${adminTab == 'audit' ? 'active' : ''}" href="${ctx}/admin/audit">Audit log</a>
</div>
<c:if test="${not empty message}"><div class="alert alert-success"><c:out value="${message}"/></div></c:if>
<c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if>
